<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Chuvadi.Layout.Sheets</RootNamespace>
    <AssemblyName>Chuvadi.Layout.Sheets</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package metadata -->
    <Product>Chuvadi.Layout.Sheets</Product>
    <Description>Excel workbook (.xlsx) importer for Chuvadi.Layout, on Chuvadi.Sheets: lays out a workbook the way Excel prints it (displayed cell text, effective styles, merges, page setup, print areas and titles, page breaks, conditional formats, pictures, shapes, chart placeholders), encrypted workbooks included. Values are never recalculated or altered. Pure BCL.</Description>
    <Authors>Arun</Authors>
    <Company>Chuvadi</Company>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/arunshivab/chuvadi</RepositoryUrl>
    <PackageTags>layout;pagination;xlsx;excel;spreadsheet;print</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chuvadi.Layout\Chuvadi.Layout.csproj" />
    <ProjectReference Include="..\Chuvadi.Sheets\Chuvadi.Sheets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chuvadi.Layout.ManualTests" />
    <InternalsVisibleTo Include="Chuvadi.Layout.Sheets.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
