<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chuvadi.OpenType: reads OpenType / TrueType font files (sfnt and collections).
    Pure BCL, no package references. Tag: opentype-vX.Y.Z.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Trimming and NativeAOT safe (D-217): the analyzers fail the build on reflection or dynamic code. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <AssemblyName>Chuvadi.OpenType</AssemblyName>
    <RootNamespace>Chuvadi.OpenType</RootNamespace>
    <PackageId>Chuvadi.OpenType</PackageId>
    <Version>0.1.0</Version>
    <Description>Reads OpenType and TrueType fonts: table directory, collections, cmap, metrics, face metrics, glyph bounds and naming, and read-only views of GDEF, GSUB and GPOS; decodes WOFF and WOFF2. Pure .NET, no dependencies.</Description>
    <IsPackable>true</IsPackable>

    <!-- Package metadata (as the other monorepo libraries) -->
    <Product>Chuvadi.OpenType</Product>
    <Authors>Arun</Authors>
    <Company>Chuvadi</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/arunshivab/chuvadi</RepositoryUrl>
    <PackageTags>fonts;opentype;truetype;cff;cmap;gsub;gpos;gdef;woff;woff2</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Chuvadi.OpenType.Tests" />
  </ItemGroup>

</Project>
