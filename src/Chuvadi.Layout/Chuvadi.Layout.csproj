<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Chuvadi.Layout</RootNamespace>
    <AssemblyName>Chuvadi.Layout</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package metadata -->
    <Product>Chuvadi.Layout</Product>
    <Description>Pure-BCL page layout engine for .NET: paginates flow documents (Word-style) and spreadsheet grids (Excel-style) into fixed pages with a neutral, immutable page display list. Font core (TrueType/OpenType/TTC, metrics, cmap, kerning), font resolution with reported substitution, lazy per-page layout, cancellation and hard limits for untrusted input. No NuGet dependencies; no PDF dependency (PDF/SVG/PNG output ships separately as Chuvadi.Layout.Pdf).</Description>
    <Authors>Arun</Authors>
    <Company>Chuvadi</Company>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/arunshivab/chuvadi</RepositoryUrl>
    <PackageTags>layout;pagination;docx;xlsx;typesetting;fonts;truetype;opentype;print</PackageTags>
  </PropertyGroup>

  <!-- Importers: one Chuvadi.Layout package with ProjectReferences to the format libraries (DESIGN.md section 1). -->
  <ItemGroup>
    <ProjectReference Include="..\Chuvadi.Docs\Chuvadi.Docs.csproj" />
    <ProjectReference Include="..\Chuvadi.Sheets\Chuvadi.Sheets.csproj" />
  </ItemGroup>

  <!-- The built-in fonts (LiPi Sans; D-101, D-113). -->
  <ItemGroup>
    <ProjectReference Include="..\Chuvadi.Fonts\Chuvadi.Fonts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chuvadi.Layout.ManualTests" />
    <InternalsVisibleTo Include="Chuvadi.Layout.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
