<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Chuvadi.Print</RootNamespace>
    <AssemblyName>Chuvadi.Print</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- D-217: trimming- and NativeAOT-safe; the analyzers run on every build (warnings are errors). -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Package metadata -->
    <Product>Chuvadi.Print</Product>
    <Description>Pure-BCL printing core for .NET: device-independent print settings (all paper sizes, orientations, duplex, colour, scale and alignment choices), page selection, page layout, print planning (copies, collation, duplex sheets), PrintJob orchestration with bounded-memory page rendering through a pluggable IPageRasterizer, the print route chooser (PrintRouter), the vector page model (VectorPage), the portable spool envelope, a PNG preview target and a one-event-per-job audit trail. Device and transport packages: Chuvadi.Print.Windows, Chuvadi.Print.Ipp, Chuvadi.Print.Remote. No NuGet dependencies.</Description>
    <Authors>Arun</Authors>
    <Company>Chuvadi</Company>
    <Version>1.0.0-rc.5</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/arunshivab/chuvadi</RepositoryUrl>
    <PackageTags>print;printing;spool;pdf;reports;preview;audit;page-layout;print-plan;print-routing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chuvadi.Print.ManualTests" />
    <InternalsVisibleTo Include="Chuvadi.Print.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
