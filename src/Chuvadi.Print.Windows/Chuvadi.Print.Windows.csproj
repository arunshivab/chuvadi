<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Chuvadi.Print.Windows</RootNamespace>
    <AssemblyName>Chuvadi.Print.Windows</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package metadata -->
    <Product>Chuvadi.Print.Windows</Product>
    <Description>Windows printing for Chuvadi.Print: printer discovery, driver capabilities (papers, trays, media types, resolutions, quality presets), DEVMODE mapping with all three paper-matching modes, and WindowsPrinterTarget printing through the GDI spooler. P/Invoke to operating-system DLLs only; no native binaries. Builds on any OS, runs on Windows. No NuGet dependencies.</Description>
    <Authors>Arun</Authors>
    <Company>Chuvadi</Company>
    <Version>1.0.0-rc.1</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/arunshivab/chuvadi</RepositoryUrl>
    <PackageTags>print;printing;windows;gdi;spooler;printer;devmode</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chuvadi.Print\Chuvadi.Print.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chuvadi.Print.ManualTests" />
    <InternalsVisibleTo Include="Chuvadi.Print.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
