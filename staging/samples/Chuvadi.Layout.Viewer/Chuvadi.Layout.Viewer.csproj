<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chuvadi.Layout.Viewer: opens a .docx / .xlsx / .txt and writes per-page SVG and PNG through Chuvadi.Layout.Pdf,
    with cancellation and limits; the reference for desktop-viewer and server-side-preview integration (docs/Chuvadi.Layout/INTEGRATION.md).
    Uses chuvadi-pdf as version-pinned packages (D-29: ChuvadiPdf.props, nuget.config). Not in Chuvadi.slnx or CI.
  -->
  <Import Project="..\..\src\Chuvadi.Layout.Pdf\ChuvadiPdf.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Chuvadi.Layout.Viewer</RootNamespace>
    <AssemblyName>Chuvadi.Layout.Viewer</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Chuvadi.Layout\Chuvadi.Layout.csproj" />
    <ProjectReference Include="..\..\..\src\Chuvadi.Layout.Markup\Chuvadi.Layout.Markup.csproj" />
    <ProjectReference Include="..\..\..\src\Chuvadi.Layout.Fonts\Chuvadi.Layout.Fonts.csproj" />
    <ProjectReference Include="..\..\..\src\Chuvadi.Layout.Documents\Chuvadi.Layout.Documents.csproj" />
    <ProjectReference Include="..\..\src\Chuvadi.Layout.Pdf\Chuvadi.Layout.Pdf.csproj" />
  </ItemGroup>

</Project>
