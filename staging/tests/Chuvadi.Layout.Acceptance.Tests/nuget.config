<?xml version="1.0" encoding="utf-8"?>
<!--
  D-29: this project takes Chuvadi.Pdf.* as packages from the local feed, a flat folder of .nupkg files:
  %USERPROFILE%/Documents/local-nuget. (Forward slashes on purpose:
  NuGet's source mapping mishandles backslashes in a source path on non-Windows hosts.)
  Scoped to this project only; the rest of the monorepo restores as before. Chuvadi.* packages come only from
  the local feed (package source mapping), everything else only from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="chuvadi-local" value="%USERPROFILE%/Documents/local-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="chuvadi-local">
      <package pattern="Chuvadi.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
