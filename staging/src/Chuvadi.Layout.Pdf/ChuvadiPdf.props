<Project>

  <!--
    D-29: projects that use chuvadi-pdf take it as version-pinned packages from the local NuGet feed
    (%USERPROFILE%\Documents\local-nuget, see the nuget.config next to each project), never from a source clone.
    Imported by Chuvadi.Layout.Pdf, Chuvadi.Layout.Pdf.Tests, Chuvadi.Layout.Acceptance and
    Chuvadi.Layout.Acceptance.Tests; none of them is in Chuvadi.slnx or CI.
    To move to a newer Chuvadi.Pdf: pack it into the feed, then change ChuvadiPdfVersion.

    D-213, D-225, D-261: the package Chuvadi.Layout.Pdf references the range ChuvadiPdfRange, [3.31.2, 4.0.0): any 3.x from
    the tested version on, since chuvadi-pdf keeps its API compatible within 3.x (D-216). NuGet picks the lowest version the
    range allows, so an application that wants a newer chuvadi-pdf references it directly. The tests and the acceptance
    harness keep the exact version, so they run on the one that was measured.
    D-261: 3.31.2 is the floor, the same as Chuvadi.Print.Pdf.Raster (D-258), so all of Chuvadi needs one chuvadi-pdf
    release and an application gets the 3.31.2 fixes. Layout's output is byte-identical on 3.31.1 and 3.31.2.
  -->
  <PropertyGroup>
    <ChuvadiPdfVersion>3.31.2</ChuvadiPdfVersion>
    <ChuvadiPdfRange>[$(ChuvadiPdfVersion), 4.0.0)</ChuvadiPdfRange>
  </PropertyGroup>

</Project>
