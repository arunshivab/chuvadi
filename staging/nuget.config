<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the projects under staging/ only (Chuvadi.Print.Pdf and its tests), decision D-29.
  Chuvadi.* packages come from Arun's local feed, where he packs chuvadi-pdf (build\pack.ps1) and Chuvadi.Print;
  everything else (test tooling) from nuget.org. Nothing else in the monorepo sees this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-nuget" value="C:\Users\aruns\Documents\local-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-nuget">
      <package pattern="Chuvadi.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
