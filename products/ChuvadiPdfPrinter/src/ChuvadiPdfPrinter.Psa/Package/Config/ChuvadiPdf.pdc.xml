<?xml version="1.0" encoding="utf-8"?>
<!--
  Print Device Capabilities for the Chuvadi PDF virtual printers: what the print dialog offers.
  Sizes in micrometres. A4 is the default (India and most of the world); Letter, Legal, A3, A5 and
  Executive are also offered. Imageable area is the full sheet (a PDF has no unprintable margin).
-->
<psf2:PrintDeviceCapabilities
  xmlns:psf2="http://schemas.microsoft.com/windows/2013/12/printing/printschemaframework2"
  xmlns:psf="http://schemas.microsoft.com/windows/2003/08/printing/printschemaframework"
  xmlns:psk="http://schemas.microsoft.com/windows/2003/08/printing/printschemakeywords"
  xmlns:psk12="http://schemas.microsoft.com/windows/2013/12/printing/printschemakeywordsv12"
  xmlns:chuvadi="http://schemas.chuvadi.dev/printing/keywords"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <psk:PageMediaSize psf2:psftype="Feature">
    <psk:ISOA4 psf2:psftype="Option" psf2:default="true">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,210000,297000</psk12:PortraitImageableSize>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">210000</psk:MediaSizeWidth>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">297000</psk:MediaSizeHeight>
    </psk:ISOA4>
    <psk:NorthAmericaLetter psf2:psftype="Option">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,215900,279400</psk12:PortraitImageableSize>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">215900</psk:MediaSizeWidth>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">279400</psk:MediaSizeHeight>
    </psk:NorthAmericaLetter>
    <psk:NorthAmericaLegal psf2:psftype="Option">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,215900,355600</psk12:PortraitImageableSize>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">215900</psk:MediaSizeWidth>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">355600</psk:MediaSizeHeight>
    </psk:NorthAmericaLegal>
    <psk:ISOA3 psf2:psftype="Option">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,297000,420000</psk12:PortraitImageableSize>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">297000</psk:MediaSizeWidth>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">420000</psk:MediaSizeHeight>
    </psk:ISOA3>
    <psk:ISOA5 psf2:psftype="Option">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,148000,210000</psk12:PortraitImageableSize>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">148000</psk:MediaSizeWidth>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">210000</psk:MediaSizeHeight>
    </psk:ISOA5>
    <psk:NorthAmericaExecutive psf2:psftype="Option">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,184150,266700</psk12:PortraitImageableSize>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">184150</psk:MediaSizeWidth>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">266700</psk:MediaSizeHeight>
    </psk:NorthAmericaExecutive>
  </psk:PageMediaSize>

  <psk:PageOrientation psf2:psftype="Feature">
    <psk:Portrait psf2:psftype="Option" psf2:default="true" />
    <psk:Landscape psf2:psftype="Option" />
  </psk:PageOrientation>

  <psk:PageOutputColor psf2:psftype="Feature">
    <psk:Color psf2:psftype="Option" psf2:default="true">
      <psk:DeviceBitsPerPixel psf2:psftype="ScoredProperty" xsi:type="xsd:integer">24</psk:DeviceBitsPerPixel>
      <psk:DriverBitsPerPixel psf2:psftype="ScoredProperty" xsi:type="xsd:integer">24</psk:DriverBitsPerPixel>
    </psk:Color>
    <psk:Grayscale psf2:psftype="Option">
      <psk:DeviceBitsPerPixel psf2:psftype="ScoredProperty" xsi:type="xsd:integer">8</psk:DeviceBitsPerPixel>
      <psk:DriverBitsPerPixel psf2:psftype="ScoredProperty" xsi:type="xsd:integer">8</psk:DriverBitsPerPixel>
    </psk:Grayscale>
  </psk:PageOutputColor>

  <psk:PageResolution psf2:psftype="Feature">
    <chuvadi:Dpi600 psf2:psftype="Option" psf2:default="true">
      <psk:ResolutionX psf2:psftype="ScoredProperty" xsi:type="xsd:integer">600</psk:ResolutionX>
      <psk:ResolutionY psf2:psftype="ScoredProperty" xsi:type="xsd:integer">600</psk:ResolutionY>
    </chuvadi:Dpi600>
  </psk:PageResolution>
</psf2:PrintDeviceCapabilities>
