<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the Chuvadi PDF product only (products/ChuvadiPdfPrinter), decision D-29.
  Chuvadi.* packages (Chuvadi.Pdf.*, and Chuvadi.Print / Chuvadi.Print.Pdf in package mode) come from Arun's local
  feed; everything else (CsWinRT, test tooling) from nuget.org. Nothing else in the monorepo sees this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-nuget" value="C:\Users\aruns\Documents\local-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-nuget">
      <package pattern="Chuvadi.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
