<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Oracle check (design note v1, D-295): compares Chuvadi.OpenType with the
    published Chuvadi.Pdf.Fonts.Rendering FontFace public API (default 3.32.1) on the
    pack fonts, and our WOFF2 decoder with Chuvadi.Pdf.Fonts.Woff2.
    Uses only those packages' public members (signatures and XML docs).
    Needs the 3.32.1 release packages, checked against SHA256SUMS.txt, in the local feed.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <ChuvadiVersion Condition="'$(ChuvadiVersion)' == ''">3.32.1</ChuvadiVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Chuvadi.Pdf.Fonts.Rendering" Version="$(ChuvadiVersion)" />
    <PackageReference Include="Chuvadi.Pdf.Fonts.Woff2" Version="$(ChuvadiVersion)" />
    <ProjectReference Include="..\..\src\Chuvadi.OpenType\Chuvadi.OpenType.csproj" />
  </ItemGroup>

</Project>
